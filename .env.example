# ==============================================================================
# FRANCHISE-API - CONFIGURACIÓN DE ENTORNO
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y nómbralo como '.env'
# 2. Configura los valores según tu entorno local
# ==============================================================================

# ================================
# BASIC CONFIGURATION
# ================================
SPRING_APPLICATION_NAME=franchise-api

# ================================
# SERVER/PROFILE
# ================================
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=9090
SERVER_SERVLET_CONTEXT_PATH=/accenture

# ================================
# DATABASE (R2DBC POSTGRESQL)
# ================================
SPRING_R2DBC_URL=r2dbc:postgresql://localhost:5432/franchise_accenture_db
SPRING_R2DBC_USERNAME=postgres
SPRING_R2DBC_PASSWORD=your_password_here
SPRING_R2DBC_POOL_INITIAL_SIZE=5
SPRING_R2DBC_POOL_MAX_SIZE=20
SPRING_DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# ================================
# JPA / HIBERNATE & TIMEZONE
# ================================
SPRING_JPA_OPEN_IN_VIEW=false
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_TIME_ZONE=UTC
SPRING_JPA_TIMEZONE=America/Bogota
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ================================
# ACTUATOR
# ================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info